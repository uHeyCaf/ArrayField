local isDragging = false
local startDrag = nil
local startPosition = nil

local function updateWindowPosition(input)
    local delta = input.Position - startDrag
    window.Position = UDim2.new(
        startPosition.X.Scale, 
        startPosition.X.Offset + delta.X, 
        startPosition.Y.Scale, 
        startPosition.Y.Offset + delta.Y
    )
end

window.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        isDragging = true
        startDrag = input.Position
        startPosition = window.Position
        
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                isDragging = false
            end
        end)
    end
end)

window.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        if isDragging then
            updateWindowPosition(input)
        end
    end
end)

local function addHoverEffect(button)
    local defaultColor = button.BackgroundColor3
    local hoverColor = Color3.fromRGB(85, 90, 95)
    
    button.MouseEnter:Connect(function()
        local fadeIn = tweenService:Create(button, TweenInfo.new(0.15), {BackgroundColor3 = hoverColor})
        fadeIn:Play()
    end)
    
    button.MouseLeave:Connect(function()
        local fadeOut = tweenService:Create(button, TweenInfo.new(0.15), {BackgroundColor3 = defaultColor})
        fadeOut:Play()
    end)
end

addHoverEffect(hubButton)
addHoverEffect(oldHubButton)

