local Players = game:GetService("Players")

local HighlightsEnabled = false

local ActiveHighlights = {}
local PlayerConnections = {}

local function ApplyHighlight(Player)
	if not HighlightsEnabled then return end

	local Connections = {}
	local PlayerId = Player.UserId

	local Character = Player.Character or Player.CharacterAdded:Wait()
	local Humanoid = Character:WaitForChild("Humanoid")
	local HightLighter = Instance.new("Highlight", Character)

	ActiveHighlights[PlayerId] = HightLighter

	local function UpdateFillColor()
		local DefaultColor = Color3.fromRGB(255, 48, 51)
		HightLighter.FillColor = (Player.TeamColor and Player.TeamColor.Color) or DefaultColor
	end

	local function Disconnect()
		if HightLighter then
			HightLighter:Remove()
		end
		ActiveHighlights[PlayerId] = nil

		for _, Connection in next, Connections do
			Connection:Disconnect()
		end
	end

	table.insert(Connections, Player:GetPropertyChangedSignal("TeamColor"):Connect(UpdateFillColor))
	table.insert(Connections, Humanoid:GetPropertyChangedSignal("Health"):Connect(function()
		if Humanoid.Health <= 0 then
			Disconnect()
		end
	end))

	PlayerConnections[PlayerId] = Connections

	UpdateFillColor()
end

local function RemoveHighlight(Player)
	local PlayerId = Player.UserId

	-- Remove highlight
	if ActiveHighlights[PlayerId] then
		ActiveHighlights[PlayerId]:Remove()
		ActiveHighlights[PlayerId] = nil
	end

	-- Disconnect connections
	if PlayerConnections[PlayerId] then
		for _, Connection in next, PlayerConnections[PlayerId] do
			Connection:Disconnect()
		end
		PlayerConnections[PlayerId] = nil
	end
end

local function HightLightPlayer(Player)
	if not HighlightsEnabled then return end

	if Player.Character then
		ApplyHighlight(Player)
	end

	local CharacterConnection = Player.CharacterAdded:Connect(function()
		if HighlightsEnabled then
			ApplyHighlight(Player)
		end
	end)

	if not PlayerConnections[Player.UserId] then
		PlayerConnections[Player.UserId] = {}
	end
	table.insert(PlayerConnections[Player.UserId], CharacterConnection)
end

local function EnableHighlights()
	HighlightsEnabled = true


	for _, Player in next, Players:GetPlayers() do
		HightLightPlayer(Player)
	end
end

local function DisableHighlights()
	HighlightsEnabled = false
	for _, Player in next, Players:GetPlayers() do
		RemoveHighlight(Player)
	end
end

local function ToggleHighlights()
	if HighlightsEnabled then
		DisableHighlights()
		print("Player highlights disabled")
	else
		EnableHighlights()
		print("Player highlights enabled")
	end
end

